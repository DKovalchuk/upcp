# Ephemeral CI quality-gate stack — upcp-test-ci (TASK-0143).
# Used ONLY via: COMPOSE_PROJECT_NAME=upcp-test-ci docker compose --env-file .env.ci ...
# Ports and data dirs are distinct from every persistent stack on the runner host:
#   dev   (upcp):      3072 / 38080 / 35432 / 36380
#   stage (upcp-stage):3070 / 38081 / 35433 / 36382
#   test  (upcp-test): 3071 / 38082 / 35434 / 36383
#   gate  (upcp-test-ci): values below.
# Data dirs live inside the invoking workspace (data/ is gitignored), so every
# gate run starts from a scratch postgres/redis and is cleaned with the workspace.

UPCP_PORT_FRONTEND=3074
UPCP_PORT_BACKEND=38084
UPCP_PORT_POSTGRES=35436
UPCP_PORT_REDIS=36386

# security profile (only used when the gate runs zap/kali)
UPCP_PORT_ZAP=38096
UPCP_PORT_KALI=38097

# perf profile (unused by the gate — suites run from the job — kept for safety)
UPCP_PORT_LOCUST=38095

# observability profile (not started by the gate; distinct just in case)
UPCP_PORT_PROMETHEUS=39093
UPCP_PORT_GRAFANA=33003
UPCP_PORT_LOKI=3103
UPCP_PORT_TEMPO=3203
UPCP_PORT_OTEL_GRPC=4323
UPCP_PORT_OTEL_HTTP=4324

UPCP_DATA_POSTGRES=./data/ci-postgres
UPCP_DATA_REDIS=./data/ci-redis
