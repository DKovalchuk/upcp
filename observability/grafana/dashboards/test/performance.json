{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "sum(rate(upcp_http_requests_total[1m])) by (handler)", "legendFormat": "{{handler}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "sum(rate(upcp_http_requests_total{status=~\"5..\"}[1m])) / sum(rate(upcp_http_requests_total[1m])) * 100", "legendFormat": "Error %" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}] } } }
    },
    {
      "title": "Latency Distribution (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(upcp_http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(upcp_http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(upcp_http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "In-Progress Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "sum(upcp_http_requests_in_progress)", "legendFormat": "In Progress" }
      ]
    },
    {
      "title": "Requests by Status Code",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "sum(increase(upcp_http_requests_total[5m])) by (status)", "legendFormat": "{{status}}" }
      ]
    },
    {
      "title": "Latency by Handler (p95)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(upcp_http_request_duration_seconds_bucket[5m])) by (handler, le))", "legendFormat": "{{handler}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 2}] } } }
    },
    {
      "title": "Auth Attempts",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "sum(rate(upcp_auth_attempts_total[1m])) by (result)", "legendFormat": "{{result}}" }
      ]
    },
    {
      "title": "Rate Limit Hits",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "sum(rate(upcp_rate_limit_hits_total[1m])) by (endpoint)", "legendFormat": "{{endpoint}}" }
      ]
    },
    {
      "title": "Claims & Heartbeats",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "sum(rate(upcp_claims_total[1m])) by (result)", "legendFormat": "claims {{result}}" },
        { "expr": "sum(rate(upcp_heartbeat_total[1m])) by (status)", "legendFormat": "heartbeats {{status}}" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["upcp", "test", "performance"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "UPCP Test — Performance",
  "uid": "upcp-test-performance",
  "version": 1
}
