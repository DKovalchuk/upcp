# Stage (pre-prod) environment — template (TASK-0167).
# Usage:
#   cp .env.stage.example .env.stage
#   edit .env.stage: UPCP_SECRET_KEY=$(openssl rand -base64 48)
#   docker compose --env-file .env.stage up -d
# .env.stage is intentionally NOT tracked (secrets stay local / in the
# masked GitLab CI variable UPCP_SECRET_KEY used by deploy:stage).

# Secrets
UPCP_SECRET_KEY=
POSTGRES_USER=upcp
POSTGRES_PASSWORD=upcp_local_change_me
POSTGRES_DB=upcp

# External-facing ports (UPCP_PORT_* contract, TASK-0119)
UPCP_PORT_FRONTEND=3070
UPCP_PORT_BACKEND=38081
UPCP_PORT_POSTGRES=35433
UPCP_PORT_REDIS=36382
